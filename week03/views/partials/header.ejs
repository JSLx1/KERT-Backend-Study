<!DOCTYPE html>
<html lang="ko">
<head>
	<meta charset="UTF-8">
	<title>KERT 게시판</title>
	<style>body { max-width: 640px; margin: 40px auto; font-family: sans-serif; }</style>
</head>
<body>
	<h1><a href="/posts">KERT 게시판</a></h1>

	<nav>
		<% if (user) { %>
			<%= user.username %> 님
			
			<% if (user.role === 'admin') { %>
				<a href="/admin">관리자</a>
			<% } %>
			
			<form method="POST" action="/logout" style="display: inline">
				<button>로그아웃</button>
			</form>
		<% } else { %>
			<a href="/login">로그인</a>
			<a href="/signup">회원가입</a>
		<% } %>
	</nav>